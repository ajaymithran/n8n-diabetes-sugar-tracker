      "parameters": {
        "text": "={{ $('Telegram Trigger').item.json.message.text }}",
        "attributes": {
          "attributes": [
            {
              "name": "sugar",
              "type": "number",
              "description": "The blood glucose reading in mg/dL exactly as written by the patient. Return null if the message contains no glucose number. Never guess a number."
            },
            {
              "name": "measurement",
              "description": "One of: Fasting, Before Meal, After Meal, Random, Other. Fasting means empty stomach or morning before eating. Before breakfast/lunch/dinner is Before Meal. After or post breakfast/lunch/dinner is After Meal. Bedtime is Other. Return an empty string if the patient did not say."
            },
            {
              "name": "notes",
              "description": "Any extra detail besides the number and measurement type, such as how the patient felt or what they ate. Empty string if none."
            },
            {
              "name": "reading_date",
              "description": "Date of the reading in YYYY-MM-DD, only if the patient explicitly mentioned a date. Empty string otherwise."
            },
            {
              "name": "reading_time",
              "description": "Time of the reading in 24-hour HH:mm, only if the patient explicitly mentioned a time. Empty string otherwise."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "=You extract blood sugar readings from short chat messages written by a diabetic patient.\nToday's date is {{ $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd') }}.\nOnly extract what the patient actually wrote. If a value is not mentioned, leave it empty or null.\nDo not give medical advice or interpret the reading."
        }
      },
