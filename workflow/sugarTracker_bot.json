    {
      "parameters": {
        "jsCode": "// Combines this message with any saved conversation state, validates it,\n// and decides what happens next: complete, need_info, invalid or unclear.\nconst msg = $('Telegram Trigger').first().json.message || {};\nconst text = String(msg.text || '').trim();\nconst lower = text.toLowerCase();\nconst hasWords = /[a-z]/i.test(text);\nconst chatId = String((msg.chat || {}).id || '');\n\nconst stateRow = $('Get Chat State').first().json || {};\nconst state = stateRow.waiting_for ? stateRow : {};\nconst ext = ($input.first().json || {}).output || {};\n\nconst TYPES = ['Fasting', 'Before Meal', 'After Meal', 'Random', 'Other'];\n\nfunction normMeasurement(value) {\n  const s = String(value || '').toLowerCase().trim();\n  if (!s) return '';\n  for (const t of TYPES) { if (s === t.toLowerCase()) return t; }\n  if (/\\b(after|post)\\b|\\bpp\\b|postprandial/.test(s)) return 'After Meal';\n  if (/\\b(before|pre)\\b/.test(s)) return 'Before Meal';\n  if (/\\bfast(ing|ed)?\\b|empty stomach/.test(s)) return 'Fasting';\n  if (/\\brandom\\b/.test(s)) return 'Random';\n  if (/\\b(bedtime|bed time|night|other)\\b/.test(s)) return 'Other';\n  return '';\n}\n\nlet measNew = '';\nlet sugarNew = null;\nconst choice = text.match(/^([1-4])\\s*\\uFE0F?\\u20E3?$/);\nif (state.waiting_for === 'measurement' && choice) {\n  // Patient answered the type question with a number 1-4\n  measNew = TYPES[Number(choice[1]) - 1];\n} else {\n  const numbers = (text.match(/\\d+(\\.\\d+)?/g) || []).map(Number);\n  const extSugar = Number(ext.sugar);\n  const extHasSugar = ext.sugar !== null && ext.sugar !== undefined && ext.sugar !== '' && isFinite(extSugar);\n  if (extHasSugar && numbers.includes(extSugar)) {\n    sugarNew = extSugar; // only trust numbers that really appear in the message\n  } else if (numbers.length === 1) {\n    sugarNew = numbers[0];\n  }\n  measNew = normMeasurement(text) || (hasWords ? normMeasurement(ext.measurement) : '');\n}\n\nconst savedSugar = (state.sugar === null || state.sugar === undefined || state.sugar === '') ? null : Number(state.sugar);\nconst sugar = sugarNew !== null ? sugarNew : savedSugar;\nconst measurement = measNew || state.measurement || '';\n\nconst extNotes = hasWords ? String(ext.notes || '').trim() : '';\nlet noteNew = extNotes;\nif (!noteNew && sugarNew !== null && text.split(/\\s+/).length > 4) noteNew = 'Original message: ' + text;\nconst notes = [state.notes, noteNew].filter(Boolean).join(' | ');\n\nlet when = $now.setZone('Asia/Kolkata');\nif (/\\byesterday\\b/.test(lower)) when = when.minus({ days: 1 });\nconst d = String(ext.reading_date || '');\nif (/\\d{1,2}[\\/.-]\\d{1,2}|\\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\\b/.test(lower) && /^\\d{4}-\\d{2}-\\d{2}$/.test(d)) {\n  const p = DateTime.fromISO(d, { zone: 'Asia/Kolkata' });\n  if (p.isValid) when = when.set({ year: p.year, month: p.month, day: p.day });\n}\nconst t = String(ext.reading_time || '');\nif (/\\d{1,2}(:\\d{2})?\\s*(am|pm)\\b|\\b\\d{1,2}:\\d{2}\\b/.test(lower) && /^\\d{1,2}:\\d{2}$/.test(t)) {\n  const hm = t.split(':').map(Number);\n  if (hm[0] < 24 && hm[1] < 60) when = when.set({ hour: hm[0], minute: hm[1] });\n}\n\nlet status = 'unclear';\nlet waitingFor = '';\nlet question = '';\nif (sugarNew !== null && (sugarNew < 20 || sugarNew > 1000)) {\n  status = 'invalid';\n} else if (sugar !== null && measurement) {\n  status = 'complete';\n} else if (sugar !== null) {\n  status = 'need_info';\n  waitingFor = 'measurement';\n  question = 'Got it: ' + sugar + ' mg/dL.\\nWas this reading fasting, before a meal, after a meal, or random?';\n} else if (measurement) {\n  status = 'need_info';\n  waitingFor = 'sugar';\n  question = 'Got it: ' + measurement + '.\\nWhat was your blood sugar reading in mg/dL?';\n}\n\nreturn [{ json: {\n  chat_id: chatId,\n  status: status,\n  waiting_for: waitingFor,\n  question: question,\n  sugar: sugar,\n  measurement: measurement,\n  notes: notes,\n  date: when.toFormat('dd-MM-yyyy'),\n  time: when.toFormat('hh:mm a'),\n  message_text: text\n} }];"
      },
